
package es.davante.edadcanina;

import androidx.databinding.ObservableField;

import es.davante.edadcanina.databinding.ActivityMainBinding;

public class EdadCaninaControlador {

    private final ActivityMainBinding binding;
    private final EdadCaninaModelo modelo;

    private final ObservableField<Integer> resultado =
            new ObservableField<>(null);

    public EdadCaninaControlador(
            MainActivity context,
            ActivityMainBinding binding) {

        this.binding = binding;
        this.modelo = new EdadCaninaModelo();
    }

    public ObservableField<Integer> getResultado() {
        return resultado;
    }

    public void calcularEdad() {

        String texto = binding.ageInput.getText()
                .toString().trim();

        if (Validacion.estaVacio(texto)) {
            mostrarError("Introduce la edad de tu perro");
            return;
        }

        if (!modelo.esNumero(texto)) {
            mostrarError("Introduce un número válido");
            return;
        }

        int edad = Integer.parseInt(texto);

        if (!modelo.esEdadValida(edad)) {
            mostrarError("La edad debe estar entre 1 y 30 años");
            return;
        }

        binding.ageInput.setError(null);

        resultado.set(modelo.calcularEdadCanina(edad));
    }

    public void limpiar() {

        binding.ageInput.setText("");
        binding.ageInput.setError(null);
        resultado.set(null);
    }

    private void mostrarError(String mensaje) {

        binding.ageInput.setError(mensaje);
        binding.ageInput.requestFocus();
        resultado.set(null);
    }
}
